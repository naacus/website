# ============================================
# NAACUS Analytics Configuration (localhost)
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ============================================
# Google Analytics 4
# ============================================
# Get this from: https://analytics.google.com
# Create a new property for NAACUS website
# Measurement ID format: G-XXXXXXXXXX
REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Microsoft 365 Analytics (Application-Level)
# ============================================
# These are from Azure AD App Registration

# Application (Client) ID
# Get from: Azure Portal → Azure Active Directory → App registrations → Your App
REACT_APP_AZURE_CLIENT_ID=your-application-id-here

# Directory (Tenant) ID
# Get from: Azure Portal → Azure Active Directory → App registrations → Your App
REACT_APP_AZURE_TENANT_ID=your-tenant-id-here

# Client Secret
# ⚠️ SECURITY WARNING: This is sensitive!
# Get from: Azure Portal → App registration → Certificates & secrets → Client secrets
# For localhost testing only - never commit to version control
# Store in secure environment for production (Azure Key Vault, GitHub Secrets, etc.)
REACT_APP_AZURE_CLIENT_SECRET=your-client-secret-here

# SharePoint Site URL
# Format: yourorganization.sharepoint.com/sites/YourSite
# Get from: Navigate to your SharePoint site and copy the domain/path
REACT_APP_SHAREPOINT_SITE_URL=yourorganization.sharepoint.com/sites/YourSite

# Event Registration List ID
# Get from: SharePoint Event Registrations list → Settings → List ID in URL (GUID)
REACT_APP_EVENT_REGISTRATION_LIST_ID=your-event-registration-list-id-here

# Analytics List ID
# Get from: SharePoint Analytics Events list → Settings → List ID in URL
# Format: GUID like 12345678-1234-1234-1234-123456789012
REACT_APP_ANALYTICS_LIST_ID=your-list-id-guid-here

# ============================================
# Testing (Optional)
# ============================================
# Enable debug logging for analytics
REACT_APP_DEBUG_ANALYTICS=true
