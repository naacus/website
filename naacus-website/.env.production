# Production Environment Configuration Template
# ⚠️  DO NOT use actual production secrets here
# Use Azure Key Vault or GitHub Secrets instead
# This file is for reference only

# ========== STRIPE - PRODUCTION ==========
# Get from: https://dashboard.stripe.com/apikeys (LIVE MODE)
# Format: Must start with pk_live_ (not pk_test_)
# Stripe will reject test keys in production
# Keep blank in source control; inject real values via CI/Key Vault at build time.
REACT_APP_STRIPE_PUBLIC_KEY=
REACT_APP_STRIPE_BUY_BUTTON_ID=
REACT_APP_STRIPE_WEBHOOK_SECRET=

# ========== API CONFIGURATION - PRODUCTION ==========
# Production API endpoint (must be HTTPS)
REACT_APP_API_BASE_URL=https://api.naacus.org

# ========== DEBUG & FEATURES - PRODUCTION ==========
# IMPORTANT: Disable debug logging in production
REACT_APP_DEBUG_PAYMENTS=false

# Enable/disable features
REACT_APP_ENABLE_DONATIONS=true
REACT_APP_ENABLE_PAYMENTS=true

# ⚠️  SECURITY NOTES:
# 1. Never commit actual keys to this file
# 2. Use Azure Key Vault for secrets management
# 3. Use GitHub Secrets for CI/CD pipeline
# 4. Rotate keys quarterly
# 5. Enable audit logging on Key Vault
# 6. Use Managed Identities for Azure authentication
