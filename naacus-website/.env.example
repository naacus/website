# Environment Variables for Microsoft 365 Integration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# Stripe Payment Integration
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here

# Get from: https://dashboard.stripe.com/payment-links (Buy Button section)
REACT_APP_STRIPE_BUY_BUTTON_ID=buy_btn_your_buy_button_id_here

# Get from: https://dashboard.stripe.com/webhooks
REACT_APP_STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ============================================
# Azure AD Application Registration
# ============================================
# Get these values from Azure Portal > Azure Active Directory > App Registrations
REACT_APP_AZURE_CLIENT_ID=your-client-id-here
REACT_APP_AZURE_TENANT_ID=your-tenant-id-here
REACT_APP_AZURE_CLIENT_SECRET=your-client-secret-here

# Redirect URI (should match the one registered in Azure AD)
REACT_APP_REDIRECT_URI=http://localhost:3000

# ============================================
# Microsoft Copilot Studio Configuration
# ============================================
# Get these from https://copilotstudio.microsoft.com
# 1. Create your bot in Copilot Studio
# 2. Go to Settings > Channels > Direct Line
# 3. Generate and copy your secret key

# Direct Line Secret Key (Required for Copilot Studio)
REACT_APP_COPILOT_DIRECT_LINE_SECRET=your_direct_line_secret_here

# Bot ID (Optional - for multi-bot scenarios)
REACT_APP_COPILOT_BOT_ID=your_bot_id_here

# Token Endpoint (Optional - for token refresh)
REACT_APP_COPILOT_TOKEN_ENDPOINT=

# Enable M365 authentication for chatbot (true/false)
REACT_APP_ENABLE_M365_AUTH=false

# M365 Client ID for chat (can be same as above or separate app)
REACT_APP_M365_CLIENT_ID=your_client_id_here

# M365 Tenant ID for chat
REACT_APP_M365_TENANT_ID=your_tenant_id_here

# ============================================
# SharePoint Configuration
# ============================================
# Format: yourdomain.sharepoint.com:/sites/sitename
REACT_APP_SHAREPOINT_SITE_URL=yourdomain.sharepoint.com:/sites/naacus
REACT_APP_EVENT_REGISTRATION_LIST_ID=your-event-registration-list-id-here

# Local API base URL (for app-only backend proxy)
REACT_APP_API_BASE_URL=http://localhost:5001

# ============================================
# Backend API Configuration
# ============================================
# Set to 'true' to use backend API instead of mock data
REACT_APP_USE_BACKEND_API=false

# Backend API base URL (adjust based on environment)
REACT_APP_BACKEND_URL=http://localhost:5000

# Payment endpoints
REACT_APP_PAYMENT_API_URL=http://localhost:5000

# Contact form endpoint
REACT_APP_CONTACT_API_URL=http://localhost:5000

# SharePoint List IDs
# Get these from SharePoint > List Settings > URL (look for List=%7B...%7D)
REACT_APP_MEMBERSHIP_LIST_ID=your-membership-list-id-here
REACT_APP_VOLUNTEER_LIST_ID=your-volunteer-list-id-here
REACT_APP_EVENT_REGISTRATION_LIST_ID=your-event-registration-list-id-here

# SharePoint List ID for chat logs (Optional)
REACT_APP_CHAT_LOG_LIST_ID=your-chat-log-list-id-here

# ============================================
# Optional: OneDrive Excel Files
# ============================================
# If using Excel instead of SharePoint Lists
# REACT_APP_MEMBERSHIP_FILE_ID=your-membership-excel-file-id
# REACT_APP_VOLUNTEER_FILE_ID=your-volunteer-excel-file-id

# ============================================
# Microsoft Graph API
# ============================================
# Graph API Endpoint (default: https://graph.microsoft.com/v1.0)
REACT_APP_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# ============================================
# Azure Application Insights (Monitoring)
# ============================================
# Azure Application Insights Connection String (Optional)
REACT_APP_APPINSIGHTS_CONNECTION_STRING=

# OpenTelemetry exporter endpoint (Optional, telemetry only)
# Example: https://otel-gateway.example.org/v1/traces
REACT_APP_OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers format: key=value,key2=value2 (example: Authorization=Bearer <token>)
REACT_APP_OTEL_EXPORTER_OTLP_HEADERS=
REACT_APP_OTEL_SERVICE_NAME=naacus-website-frontend
REACT_APP_OTEL_SERVICE_VERSION=0.1.0
REACT_APP_OTEL_ENVIRONMENT=development
REACT_APP_OTEL_SAMPLE_RATE=1

# ============================================
# Power Automate (Automation)
# ============================================
# Power Automate Flow URL for notifications (Optional)
REACT_APP_POWERAUTOMATE_FLOW_URL=
