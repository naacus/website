{
  "name": "naacus-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "@azure/msal-react": "^5.5.3",
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.333",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^17.4.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^10.0.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && cp ../staticwebapp.config.json build/",
    "test": "react-scripts test",
    "lint": "eslint src/**/*.js",
    "lint:a11y": "eslint src/**/*.js --max-warnings=0",
    "test:a11y": "react-scripts test --watchAll=false --testPathPattern=a11y",
    "check:a11y": "npm run lint:a11y && npm run test:a11y -- --watch=false",
    "start:api": "node server/api-server.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@fluentui)/)"
    ],
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
