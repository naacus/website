{
  "name": "naacus-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "^4.27.0",
    "@azure/msal-react": "^3.0.23",
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^11.0.0",
    "react-snap": "^1.23.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "sync:leadership:photos": "node scripts/normalize-leadership-photos.js",
    "check:leadership:photos": "node scripts/normalize-leadership-photos.js --check",
    "sync:locale-sections": "node scripts/sync-locale-sections.js",
    "sync:locale-sections:bootstrap": "node scripts/sync-locale-sections.js --bootstrap",
    "check:locale:parity": "node scripts/check-locale-parity.js",
    "check:locale:cms": "node scripts/check-cms-locale-coverage.js",
    "check:translations": "npm run sync:locale-sections && npm run check:locale:parity && npm run check:locale:cms",
    "eval:ai-first": "node scripts/eval-ai-first.js",
    "eval:ai-first:html": "npm run eval:ai-first && python3 scripts/render-ai-first-report.py reports/ai-first-eval.json reports/ai-first-eval.html",
    "check:ai-first:thresholds": "node scripts/check-ai-first-thresholds.js",
    "check:ai-first:thresholds:example": "mkdir -p reports && cp scripts/fixtures/ai-first-metrics.example.json reports/ai-first-metrics.json && node scripts/check-ai-first-thresholds.js",
    "prestart": "npm run sync:leadership:photos && npm run sync:locale-sections",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:images:check": "node scripts/optimize-images.js --check",
    "prebuild": "npm run sync:leadership:photos && npm run sync:locale-sections && npm run optimize:images",
    "start": "react-scripts start",
    "build": "react-scripts build && cp ../staticwebapp.config.json build/",
    "postbuild": "react-snap",
    "test": "react-scripts test",
    "lint": "eslint src/**/*.js",
    "lint:a11y": "eslint src/**/*.js --max-warnings=0",
    "test:a11y": "react-scripts test --watchAll=false --testPathPattern=a11y",
    "check:a11y": "npm run lint:a11y && npm run test:a11y -- --watch=false",
    "start:api": "node server/api-server.js",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/about",
      "/events",
      "/convention-map",
      "/resources",
      "/membership",
      "/contact",
      "/leadership",
      "/fellowship-ministries",
      "/programs-activities",
      "/volunteer",
      "/donation",
      "/newsletters",
      "/prayer-library",
      "/faq",
      "/feedback",
      "/dues-registration",
      "/2025"
    ],
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@fluentui)/)"
    ]
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "serialize-javascript": ">=7.0.5",
    "underscore": ">=1.13.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
