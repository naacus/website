{
  "name": "naacus-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/msal-browser": "^4.27.0",
    "@azure/msal-react": "^3.0.23",
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^10.0.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "sync:locale-sections": "node scripts/sync-locale-sections.js",
    "sync:locale-sections:bootstrap": "node scripts/sync-locale-sections.js --bootstrap",
    "prestart": "npm run sync:locale-sections",
    "prebuild": "npm run sync:locale-sections",
    "start": "react-scripts start",
    "build": "react-scripts build && cp ../staticwebapp.config.json build/",
    "test": "react-scripts test",
    "lint": "eslint src/**/*.js",
    "lint:a11y": "eslint src/**/*.js --max-warnings=0",
    "test:a11y": "react-scripts test --watchAll=false --testPathPattern=a11y",
    "check:a11y": "npm run lint:a11y && npm run test:a11y -- --watch=false",
    "start:api": "node server/api-server.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@fluentui)/)"
    ]
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "serialize-javascript": ">=7.0.5",
    "underscore": ">=1.13.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
