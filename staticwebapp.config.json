{
  "routes": [
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/admin/*",
      "/static/*",
      "/locales/*",
      "/naacus2025/*",
      "/*.js",
      "/*.css",
      "/*.json",
      "/*.yml",
      "/favicon.ico",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.eot"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".svg": "image/svg+xml"
  }
}
